{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "setlist-builder",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",

  // Static frontend (public/) is served for free; only /api/* hits the Worker.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  // One Durable Object holds the shared queue so everyone sees the same list instantly.
  "durable_objects": {
    "bindings": [{ "name": "ROOM", "class_name": "Room" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }],

  "vars": {
    // Max songs one person can have waiting in the queue at once (host is exempt).
    "MAX_PER_PERSON": "5",
    // Music catalog. Leave as-is in production; only changed for local testing.
    "ITUNES_BASE": "https://itunes.apple.com",
    "CHARTS_BASE": "https://rss.marketingtools.apple.com",
    // Fallback catalog when Apple refuses requests from Cloudflare.
    "DEEZER_BASE": "https://api.deezer.com"
  }
  // The dashboard password is a secret, not a var:  npx wrangler secret put ADMIN_PASSWORD
}
